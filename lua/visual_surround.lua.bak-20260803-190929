-- nvim-surround уже установлен в plugins/init.lua.
-- Эти бинды добавляют Sublime-подобное поведение: выделил текст и нажал
-- кавычку/скобку — выделение сразу оборачивается в парные символы.
local surrounds = {
  ['"'] = 'S"',
  ["'"] = "S'",
  ["`"] = "S`",
  ["("] = "S)",
  [")"] = "S)",
  ["["] = "S]",
  ["]"] = "S]",
  ["{"] = "S}",
  ["}"] = "S}",
  ["<"] = "S>",
  [">"] = "S>",

  -- Те же физические клавиши на русской раскладке.
  ["э"] = "S'",
  ["Э"] = 'S"',
  ["ё"] = "S`",
  ["Ё"] = "S`",
  ["х"] = "S]",
  ["ъ"] = "S]",
  ["Х"] = "S}",
  ["Ъ"] = "S}",
}

for key, action in pairs(surrounds) do
  vim.keymap.set("x", key, action, {
    remap = true,
    silent = true,
    desc = "Surround selection",
  })
end
